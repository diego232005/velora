# Copiar a backend/.env.production y rellenar secretos reales.
# Dominio: https://<SUBDOMINIO>.duckdns.org

NODE_ENV=production
PORT=4000

# Orígenes públicos (mismo host vía Caddy HTTPS)
FRONTEND_ORIGIN=https://TU-SUBDOMINIO.duckdns.org
PUBLIC_FRONTEND_ORIGIN=https://TU-SUBDOMINIO.duckdns.org

# MySQL (servicio Docker: mysql)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Velora_Mysql_2026!
DB_NAME=velora_betplay

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=velora
POSTGRES_PASSWORD=Velora_Pg_2026!
POSTGRES_DB=velora_bets

# SQL Server
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Velora_Sql_2026!
MSSQL_DATABASE=velora_identity
MSSQL_TRUST_CERT=true

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=velora_audit

# Firebase (cloud; montar JSON en /app/secrets)
FIREBASE_PROJECT_ID=velora-betplay-660e7
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-adminsdk.json
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_USE_EMULATOR=false

# Wompi sandbox — actualizar redirect en dashboard Wompi al dominio HTTPS
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_REDIRECT_URL=https://TU-SUBDOMINIO.duckdns.org/billetera
ALLOW_WOMPI_SIMULATION=true

# Google OAuth — Authorized redirect URI en Google Cloud:
#   https://TU-SUBDOMINIO.duckdns.org/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU-SUBDOMINIO.duckdns.org/api/oauth/google/callback

# Microsoft OAuth (opcional / pendiente Entra)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://TU-SUBDOMINIO.duckdns.org/api/oauth/microsoft/callback
MICROSOFT_TENANT=common
ALLOW_OAUTH_LINK_DEMO=false

# Google Drive (lectura escudos; uploads locales si Drive falla)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHIELDS_FOLDER_ID=
GOOGLE_DRIVE_PROFILES_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=
