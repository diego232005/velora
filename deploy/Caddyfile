# DOMAIN se inyecta desde docker-compose (ej. velora-betplay.duckdns.org)
{$DOMAIN} {
	encode gzip

	# API + uploads + WebSocket
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /uploads/* {
		reverse_proxy backend:4000
	}
	handle /ws {
		reverse_proxy backend:4000
	}

	# SPA React (nginx en frontend)
	handle {
		reverse_proxy frontend:80
	}
}
